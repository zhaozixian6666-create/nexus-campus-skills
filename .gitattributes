# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做文本转换
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.zip   binary

# 文本文件显式声明
*.md    text eol=lf
*.py    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.csv   text eol=lf

# GitHub 语言统计：识别为文档型仓库
*.md    linguist-documentation
*.html  linguist-documentation
